{
  "version": 1,
  "engine": "forces then excludes then requires; reroll the offending slot; max 24 attempts per token",
  "dignity": [
    "No trait may depict poverty as costume, joke, or rarity flex.",
    "No cardboard-sign gags, trash piles, bottles-as-identity, or 'homeless starter kit' loadouts.",
    "Patchwork and well-loved wear mean care and use, not degradation.",
    "Worried / chattering expressions are weather reactions, never class identity."
  ],
  "rules": [
    {
      "id": "held-item-needs-hold-pose",
      "if": { "slot": "held_item", "not_in": ["none"] },
      "requires": { "slot": "arm_pose", "ids": ["hold-item", "hold-two-hand"] },
      "reason": "An item in the hand requires a grip pose."
    },
    {
      "id": "two-hand-items",
      "if": { "slot": "held_item", "in": ["map"] },
      "forces": { "slot": "arm_pose", "id": "hold-two-hand" },
      "reason": "Map is two-handed."
    },
    {
      "id": "one-hand-items",
      "if": { "slot": "held_item", "in": ["coffee", "lantern"] },
      "forces": { "slot": "arm_pose", "id": "hold-item" },
      "reason": "Single-hand grip."
    },
    {
      "id": "empty-hands-no-hold",
      "if": { "slot": "held_item", "equals": "none" },
      "excludes": { "slot": "arm_pose", "ids": ["hold-item", "hold-two-hand"] },
      "reason": "Do not leave a gripping hand empty."
    },
    {
      "id": "wave-no-item",
      "if": { "slot": "arm_pose", "equals": "wave" },
      "forces": { "slot": "held_item", "id": "none" },
      "reason": "A waving arm cannot also present a held object in v1."
    },
    {
      "id": "trapper-excludes-ear-hats",
      "if": { "slot": "headwear", "equals": "trapper-hat" },
      "excludes": { "slot": "headwear", "ids": ["earflap-beanie"] },
      "reason": "Ear zone collision. Slot exclusivity already prevents this; kept as documentation."
    },
    {
      "id": "wave-no-umbrella-space",
      "if": { "slot": "arm_pose", "equals": "wave" },
      "excludes": { "slot": "headwear", "ids": ["halo"] },
      "reason": "Raised hand occupies the halo arc on the waving side."
    },
    {
      "id": "north-star-body-prefers-night",
      "if": { "slot": "body", "equals": "north-star-navy" },
      "requires": { "slot": "background", "ids": ["cold-blue-night", "starry-night", "first-light", "abstract-snow"] },
      "reason": "Legendary navy-star fabric needs a dark or quiet field."
    },
    {
      "id": "aurora-not-noon-camp",
      "if": { "slot": "body", "equals": "aurora" },
      "excludes": { "slot": "background", "ids": ["campground"] },
      "reason": "Iridescent cloth wants dawn, dusk, or night."
    },
    {
      "id": "quilt-patterns-bags-only",
      "if": { "slot": "pattern", "in": ["plaid", "patchwork"] },
      "classes_only": ["sleeping-bag"],
      "reason": "Bag fabric language."
    },
    {
      "id": "tent-panels-tents-only",
      "if": { "slot": "pattern", "in": ["two-tone-panel"] },
      "classes_only": ["small-tent", "large-tent"],
      "reason": "Tent fabric language."
    },
    {
      "id": "large-tent-structure",
      "if": { "slot": "structural", "in": ["extra-panels"] },
      "classes_only": ["large-tent"],
      "reason": "Lodge-only extra panels."
    }
  ]
}
